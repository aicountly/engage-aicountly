# AICOUNTLY Engage Portal API (CodeIgniter 4.6)
# Copy to .env locally; NEVER commit a real .env.
# On cPanel, this file lives at public_html/api/.env

CI_ENVIRONMENT=production
app.baseURL=https://engage.aicountly.org/api/
app.indexPage=

# ---------------------------------------------------------------------------
# PostgreSQL (Engage portal database — dedicated; do not point at other apps)
# DB name, DB user, and password come ONLY from this file. Never hardcoded.
# ---------------------------------------------------------------------------
ENGAGE_DB_HOST=127.0.0.1
ENGAGE_DB_PORT=5432
ENGAGE_DB_NAME=engage_aicountly
ENGAGE_DB_USER=
ENGAGE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Auth & encryption (generate strong random values; never commit real secrets)
# Generate: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# ---------------------------------------------------------------------------
ENGAGE_JWT_SECRET=
ENGAGE_JWT_TTL_MINUTES=720

# CORS — comma-separated origins allowed to call the API.
ENGAGE_ALLOWED_ORIGINS=https://engage.aicountly.org,http://localhost:5173

# ---------------------------------------------------------------------------
# Console orchestrator (outbound: Engage -> Console)
# ---------------------------------------------------------------------------
CONTROLLER_APP_CODE=engage
CONSOLE_API_URL=https://console.aicountly.org/api
CONSOLE_API_BASE_URL=https://console.aicountly.org/api
# Staff roles come from Console → Roles & Access. Engage re-checks them on token
# refresh via GET {CONSOLE_API_URL}/portal/controller-apps/user-access using
# this bearer token (a Console service token with capability `staff.roles`,
# bound to app_code `engage`). REQUIRED IN PRODUCTION: without it a refresh
# cannot see a role removed in Console (a warning is logged and the locally
# mirrored roles are reused). When Console is unreachable, refresh is allowed
# only while the last confirmed sync is less than 12 hours old.
# The same key (capability `audit.write`) sends Engage's central audit to
# POST {CONSOLE_API_URL}/portal/audit (outbox; cron `php spark engage:console-audit-deliver`).
CONSOLE_API_TOKEN=

# Console's Cron Job Monitor (console-react-app docs/CRON_MONITORS.md): the audit-deliver cron command reports
# each delivery run as monitor engage.console_audit_deliver with this key — the value Console's CRON_MONITOR_KEY /
# CRON_MONITOR_KEY_HASH accepts (else CONSOLE_SERVICE_KEY is tried). Unset: nothing is reported (the monitor
# reads OVERDUE); a failed report never fails the command. CONSOLE_API_BASE overrides the Console base
# (else CONSOLE_API_URL, else https://console.aicountly.org/api).
CONSOLE_CRON_MONITOR_KEY=
# Shared secret used both:
#   - as the value of the X-Console-Portal-Key header on outbound Engage -> Console calls
#   - as the Bearer token Console uses to call back into Engage (portal/bot/*)
# Must match Console's ENGAGE_BOT_SERVICE_KEY / bot_portals.service_key_hash.
CONSOLE_INBOUND_KEY=
ENGAGE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Partner Portal (partner.aicountly.com) — owns all partner data.
# Engage's Partner Master screen (Add/Edit/Delete/List) calls this API rather
# than storing partner rows itself. Value must match PARTNER_ADMIN_KEY in the
# Partner Portal's own api/.env.
# Generate: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# ---------------------------------------------------------------------------
PARTNER_PORTAL_API_URL=https://partner.aicountly.com/api
PARTNER_PORTAL_ADMIN_KEY=

# ---------------------------------------------------------------------------
# Playwright worker (worker.apis.aicountly.com — screenshots/reports only)
# ---------------------------------------------------------------------------
WORKER_BASE_URL=https://worker.apis.aicountly.com
WORKER_API_TOKEN=

# ---------------------------------------------------------------------------
# Reach ingest (Reach campaign leads -> POST /api/internal/reach/leads)
# Reach sends header  X-Portal-Token: <REACH_INBOUND_TOKEN>
# ---------------------------------------------------------------------------
REACH_INBOUND_TOKEN=

# ---------------------------------------------------------------------------
# Reach outcomes (Engage -> Reach: POST {REACH_API_BASE_URL}/v1/inbound/engage/lead-outcomes,
# header X-Engage-Token). The token must equal REACH_INBOUND_ENGAGE_TOKEN in Reach's .env (>= 32 chars).
# Unset: outcome events are queued (engage_reach_outcome_outbox) but not sent.
# Cron: php spark engage:reach-outcomes-deliver (every 5 minutes).
# ---------------------------------------------------------------------------
REACH_API_BASE_URL=https://reach.aicountly.org/api
REACH_OUTCOME_TOKEN=

# ---------------------------------------------------------------------------
# Seller programme (seller.aicountly.com) — docs/SELLER_PROGRAM.md
# ---------------------------------------------------------------------------
# Shared with the seller BFF (its SELLER_PORTAL_KEY), header X-Seller-Portal-Key. >= 32 chars.
# Generate: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
SELLER_PORTAL_KEY=
# Encrypts seller PAN / GSTIN / bank account and KYC documents at rest (libsodium secretbox).
# 32 bytes as 64 hex chars (or base64). Without it KYC answers 503. Keep a backup: lost key = unreadable KYC.
# After a rotation put the old key in ENGAGE_DATA_KEY_PREVIOUS so existing rows still decrypt.
ENGAGE_DATA_KEY=
ENGAGE_DATA_KEY_PREVIOUS=
# Directory for encrypted KYC documents — OUTSIDE the web root in production (e.g. /home/engage/seller-kyc).
# Default: writable/seller-kyc (inside public_html/api, denied by .htaccess).
ENGAGE_SELLER_DOCS_PATH=
# Links in activation / reset emails: {SELLER_PORTAL_BASE_URL}/activate?token=… and /reset-password?token=…
SELLER_PORTAL_BASE_URL=https://seller.aicountly.com
# Referral links shown to sellers (?ref=SLR-NNNNNN).
SELLER_REFERRAL_WEBSITE_URL=https://www.aicountly.com/
SELLER_REFERRAL_APP_URL=https://my.aicountly.com/
# Seller email: console | smtp | (empty = none: activation / reset links are shown once to the approving staff
# member; password-reset requests from the portal answer 503 — nothing is ever reported as sent when it was not).
#   console: POST {CONSOLE_API_URL}/portal/notifications/send with CONSOLE_API_TOKEN (needs notify.send + notify.direct
#            for product ENGAGE_SELLER_NOTIFY_PRODUCT and active templates seller_activation, seller_password_reset,
#            seller_login_otp — Console must also accept direct recipients for that product).
#   smtp:    ENGAGE_SMTP_* below.
ENGAGE_SELLER_MAILER=
ENGAGE_SELLER_NOTIFY_PRODUCT=engage
ENGAGE_SMTP_HOST=
ENGAGE_SMTP_PORT=587
ENGAGE_SMTP_USER=
ENGAGE_SMTP_PASS=
ENGAGE_SMTP_CRYPTO=tls
ENGAGE_MAIL_FROM=
ENGAGE_MAIL_FROM_NAME=AICOUNTLY Sellers

# ---------------------------------------------------------------------------
# Weekly seller payouts ⇄ finance.aicountly.org — docs/SELLER_PROGRAM.md § 6
# Engage compiles DRAFT batches; a person in Finance reviews / finalises them. Engage marks a payout paid only
# when Finance reports `paid` with a UTR.
# Outbound: POST {FINANCE_API_BASE_URL}/v1/inbound/engage/payout-batches, header X-Engage-Key: FINANCE_OUTBOUND_KEY
#   (= FINANCE_INBOUND_ENGAGE_KEY in Finance's .env, >= 32 chars). Unset → the weekly run fails closed (recorded as
#   failed, nothing reserved; the commission rolls into a later run).
# Inbound:  POST /api/v1/inbound/finance/payout-status, header X-Finance-Key: ENGAGE_INBOUND_FINANCE_KEY
#   (= ENGAGE_FINANCE_KEY in Finance's .env, >= 32 chars). Unset → 503.
# Keep the /api in FINANCE_API_BASE_URL: without it the POST reaches Finance's web app (200 index.html), which is
#   not Finance's receipt — the run is recorded delivery_failed, nothing is reported sent.
# Cron: php spark engage:seller-payout-run (Monday 10:00 IST) and engage:finance-payouts-deliver (every 5 minutes).
# Minimum payout per seller: Settings → seller_payout_min_threshold (default "500.00"; below it rolls over).
# ---------------------------------------------------------------------------
FINANCE_API_BASE_URL=https://finance.aicountly.org/api
FINANCE_OUTBOUND_KEY=
ENGAGE_INBOUND_FINANCE_KEY=
# Optional issuer block on the seller's payout statement (empty = no issuer block).
PAYOUT_ISSUER_NAME=
PAYOUT_ISSUER_ADDRESS=
PAYOUT_ISSUER_GSTIN=

# ---------------------------------------------------------------------------
# Manage licensing (optional; service placeholder only, not wired)
# ---------------------------------------------------------------------------
MANAGE_API_BASE_URL=
MANAGE_API_TOKEN=

# ---------------------------------------------------------------------------
# LLM provider for the Sales Bot (optional; deterministic fallback if empty)
# ---------------------------------------------------------------------------
ENGAGE_LLM_PROVIDER=
ENGAGE_LLM_API_KEY=
ENGAGE_LLM_MODEL=

# ---------------------------------------------------------------------------
# Credit approval routing — amounts above this threshold require approval.
# ---------------------------------------------------------------------------
ENGAGE_CREDIT_LARGE_THRESHOLD=10000

# ---------------------------------------------------------------------------
# Initial Owner (OwnerSeeder — first deploy only)
# ---------------------------------------------------------------------------
# ENGAGE_OWNER_EMAIL=owner@aicountly.org
# ENGAGE_OWNER_NAME=Engage Owner
# ENGAGE_OWNER_PASSWORD=
